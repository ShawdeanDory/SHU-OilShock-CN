{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/shu-oilshock/frozen_numbers.schema.json",
  "title": "3coding-visual standard frozen numbers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frozen_at",
    "source_file",
    "source_sha256",
    "values"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "frozen_at": {
      "type": "string"
    },
    "source_file": {
      "const": "results/final_numbers.json"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "values": {
      "type": "object"
    }
  }
}
