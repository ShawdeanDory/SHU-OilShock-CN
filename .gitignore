# Secrets and local configuration
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# LaTeX auxiliary files
paper/**/*.aux
paper/**/*.bbl
paper/**/*.bcf
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.lof
paper/**/*.log
paper/**/*.lot
paper/**/*.out
paper/**/*.run.xml
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.xdv

# Temporary files
*.tmp
*.temp
~$*
tmp/
output/
.env
.env.local
.env.*.local

# Large downloaded archives and private caches
data/raw/*.zip
data/raw/*.7z
data/raw/*.rar
data/cache/

# Re-downloadable snapshots whose providers prefer processed subsets or citations
data/raw/oecd_*.csv
data/raw/nbs_*_release_*.html
data/raw/ndrc_fuel_control_*.html

# Manual exports may have redistribution restrictions
data/raw/manual/*
!data/raw/manual/README.md
